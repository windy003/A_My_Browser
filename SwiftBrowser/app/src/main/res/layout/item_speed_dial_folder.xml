<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- 文件夹卡片：显示 2x2 小图标预览 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/folder_preview_bg">

        <GridLayout
            android:id="@+id/gridPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivPreview1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                android:scaleType="fitCenter"
                android:contentDescription="预览1" />

            <ImageView
                android:id="@+id/ivPreview2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                android:scaleType="fitCenter"
                android:contentDescription="预览2" />

            <ImageView
                android:id="@+id/ivPreview3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                android:scaleType="fitCenter"
                android:contentDescription="预览3" />

            <ImageView
                android:id="@+id/ivPreview4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="1dp"
                android:scaleType="fitCenter"
                android:contentDescription="预览4" />

        </GridLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>
